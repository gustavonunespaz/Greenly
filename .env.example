# ──────────────────────────────────────────────────────────────────────────────
# 🌱 Greenly — Configuração Geral (Docker Compose)
# ──────────────────────────────────────────────────────────────────────────────
# Instruções: Copie este arquivo para um novo arquivo chamado .env
# O Docker Compose usará os valores abaixo caso o arquivo .env não exista.

# ── Banco de Dados (Postgres) ──
POSTGRES_DB=greenly
POSTGRES_USER=postgres
POSTGRES_PASSWORD=greenly
POSTGRES_PORT=5435

# ── Cache & Filas (Redis) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Segurança (JWT) ──
# ATENÇÃO: Troque estes valores para produção!
JWT_ACCESS_SECRET=super_secret_dev_key_123
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=ultra_secret_refresh_key_456
JWT_REFRESH_EXPIRES_IN=7d

# ── E-mail (Configuração para MailHog em desenvolvimento) ──
SMTP_HOST=mailhog
SMTP_PORT=1025
EMAIL_FROM="Greenly <nao-responda@greenly.test>"

# ── URLs da Aplicação ──
# As portas abaixo são as expostas nos containers Nginx/API
APP_URL=http://localhost:8080
API_URL=http://localhost:3333
SITE_URL=http://localhost:8081

# ── Compliance & Alertas ──
LICENCA_RENOVACAO_ANTECEDENCIA_DIAS=120
CONDICIONANTE_ALERTA_DIAS=30
PARCEIRO_LICENCA_ALERTA_DIAS=60

# ── Processamento de Documentos ──
ENABLE_DOCUMENTO_WORKER=true
DOCUMENTOS_WORKER_CONCURRENCY=2
DOCUMENTOS_UPLOAD_MAX_MB=20
DOCUMENTOS_MODO_SEM_CUSTO=true
